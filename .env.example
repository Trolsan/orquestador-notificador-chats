# API (FastAPI)
API_HOST=0.0.0.0
API_PORT=8000

# Base URL for Cypress and local HTTP clients (host machine)
API_BASE_URL=http://localhost:8000

# n8n → API URL inside Docker Compose (service hostname, NOT localhost)
API_INTERNAL_URL=http://api:8000

# Docker Compose — n8n UI port
N8N_PORT=5678

# Timezone for n8n logs and schedules
TZ=America/Bogota
